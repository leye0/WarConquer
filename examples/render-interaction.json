{
  "html": "patate-radar.html",
  "steps": [
    {
      "action": "click",
      "selector": "#dispatch-fleet"
    },
    {
      "action": "assertText",
      "selector": "#fleet-status",
      "includes": "FLEET DISPATCHED"
    },
    {
      "action": "screenshot",
      "name": "01-after-click"
    },
    {
      "action": "type",
      "selector": "#fleet-code",
      "text": "orion-7"
    },
    {
      "action": "press",
      "key": "Enter"
    },
    {
      "action": "assertText",
      "selector": "#fleet-status",
      "includes": "CONFIRMED: ORION-7"
    },
    {
      "action": "screenshot",
      "name": "02-after-enter"
    }
  ]
}
